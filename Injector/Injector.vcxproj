  <ItemGroup>
    <ClInclude Include="ManualMapper.h" />
    <ClInclude Include="resource.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build-order-only dependency: Osiris.dll must exist before the
         resource script is generated / compiled (RCDATA embedding). We do
         NOT want to link against Osiris.lib, hence both flags are off. -->
    <ProjectReference Include="..\Source\Osiris.vcxproj">
      <Project>{dd077013-2b61-4122-970e-63e63055eaa8}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <UseLibraryDependencyInputs>false</UseLibraryDependencyInputs>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <MASM Include="Shellcode.asm" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="Injector.rc" />
    <ResourceCompile Include="$(IntDir)EmbeddedDll.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.targets" />
  </ImportGroup>
  <!-- Embeds the freshly built Osiris.dll into Injector.exe as an RCDATA
       resource (replaces the old generate_embedded.ps1 byte-array header).
       The script is a single line with the absolute DLL path baked in, so
       rc.exe never has to guess relative-path resolution. The path must use
       forward slashes: rc.exe treats backslash sequences such as \x64 as C
       escapes and would mangle the filename (RC2135). Incremental:
       regenerates only when the DLL is newer than the script. -->
  <Target Name="GenerateEmbeddedDllRc" BeforeTargets="ResourceCompile"
          Inputs="$(OutDir)Osiris.dll;$(MSBuildThisFileFullPath)"
          Outputs="$(IntDir)EmbeddedDll.rc">
    <PropertyGroup>
      <_EmbeddedDllRcPath>$([System.String]::Copy('$(OutDir)Osiris.dll').Replace('\','/'))</_EmbeddedDllRcPath>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntDir)EmbeddedDll.rc" Overwrite="true"
                      Lines="// Generated by Injector.vcxproj - do not edit.;#define IDR_EMBEDDED_DLL 101;IDR_EMBEDDED_DLL RCDATA &quot;$(_EmbeddedDllRcPath)&quot;" />
  </Target>
</Project>
